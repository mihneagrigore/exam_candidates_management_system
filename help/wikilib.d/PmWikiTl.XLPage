targets=PmWiki.Internationalizations,PmWikiTl.XLPageCookbook,PmWiki.LayoutVariables
text=(:Summary: Conversion rules to convert PmWiki's prompts into Tagalog:)%0aThis page contains the conversion rules to convert PmWiki's prompts into another language. %0aSee [[(https://www.pmwiki.org/wiki/)Localization.Localization]] and [[PmWiki/Internationalizations]] for how to details.%0a%0aStrings have the original (English) text on the left-hand-side, and two quotation marks on the%0aright-hand-side which can be filled with the translation. %0a%0aSome strings already have an English explanation on the right-hand-side, which can be replaced with the appropriate translation, to explain the cryptic string names on the left-hand-side. %0a%0aLines commencing with the comment character "#" do not need to be translated.%0a%0aOther strings to be translated, including some used in previous versions of PmWiki, may be found at [[XLPageCookbook]].%0a%0a[@%0a  ### Locale identifier, e.g. 'tl' or 'tl_PH' or 'tl_PH.UTF-8'%0a  'Locale' => 'tl_PH.UTF-8',%0a  ### Time format, e.g. '%25Y-%25m-%25d %25H:%25M'%0a  'TimeFmt' => '',%0a%0a  ﻿(:nl:tl:)      # next link%0a(:nl:susunod:) # next link in Tagalog%0a(:xl:translate:)%0a%0a%0a### Character encoding, 'utf-8' highly recommended for new wikis%0a'xlpage-i18n' => 'utf-8',%0a### Locale identifier, e.g. 'de' or 'cs_CZ.ISO-8859-2'%0a'Locale' => 'tl',%0a### Time format, e.g. '%25Y-%25m-%25d %25H:%25M EET'%0a'TimeFmt' => '%25Y-%25m-%25d %25H:%25M PHT',%0a%0a%0a### Standard layout strings%0a'View' => 'Tingnan',%0a'Edit' => 'I-edit',%0a'History' => 'Kasaysayan',%0a'Attach' => 'Ikabit',%0a'Print' => 'I-print',%0a'Backlinks' => 'Mga Backlink',%0a'Login' => 'Mag-login',%0a'Logout' => 'Mag-logout',%0a'Recent Changes' => 'Mga Kamakailang Pagbabago',%0a'Search' => 'Maghanap',%0a'Page last modified on {$LastModified}' => 'Huling binago ang pahina noong {$LastModified}',%0a'Go' => 'Pumunta',%0a'All Recent Changes' => 'Lahat ng Kamakailang Pagbabago',%0a# access keys%0a# 'ak_view' => '',%0a# 'ak_edit' => 'e',%0a# 'ak_history' => 'h',%0a# 'ak_attach' => '',%0a# 'ak_print' => '',%0a# 'ak_backlinks' => '',%0a# 'ak_logout' => '',%0a# 'ak_recentchanges' => 'c',%0a%0a%0a### PageTitle/LinkText technical pages (for full list see page Localization.Localization)%0a'RecentChanges' => 'Mga Kamakailang Pagbabago',%0a'AllRecentChanges' => 'Lahat ng Kamakailang Pagbabago',%0a'GroupHeader' => 'Header ng Grupo',%0a'GroupFooter' => 'Footer ng Grupo',%0a'SideBar' => 'SideBar',%0a'GroupAttributes' => 'Mga Atributo ng Grupo',%0a%0a%0a### Print layout strings%0a'From $WikiTitle' => 'Mula sa $WikiTitle',%0a'Retrieved from {$PageUrl}' => 'Nakuha mula sa {$PageUrl}',%0a%0a%0a### Page locations%0a'{$SiteGroup}/EditQuickReference' => '{$SiteGroup}/MabilisNaSanggunianSaPag-edit',%0a'{$SiteGroup}/UploadQuickReference' => '{$SiteGroup}/MabilisNaSanggunianSaPag-upload',%0a'{$SiteGroup}/Search' => '{$SiteGroup}/Maghanap',%0a'{$SiteGroup}.PageNotFound' => '{$SiteGroup}.PahinaHindiNakita',%0a%0a%0a### Browse page strings%0a'redirected from' => 'na-redirect mula sa',%0a%0a%0a### Edit page strings%0a'Editing {*$FullName}' => 'Ini-edit ang {*$FullName}',%0a'Save' => 'I-save',%0a'Save and edit' => 'I-save at i-edit',%0a'Publish' => 'I-publish',%0a'Save draft' => 'I-save ang draft',%0a'Save draft and edit' => 'I-save ang draft at i-edit',%0a'Preview' => 'I-preview',%0a'Cancel' => 'Kanselahin',%0a'Reset' => 'I-reset',%0a'Author' => 'May-akda',%0a'An author name is required.' => 'Kailangan ang pangalan ng may-akda.',%0a'Summary' => 'Buod',%0a'This is a minor edit' => 'Ito ay isang menor na pagbabago',%0a'Preview {*$FullName}' => 'I-preview ang {*$FullName}',%0a'End of preview -- remember to save' => 'Wakas ng preview -- tandaan na i-save',%0a'Page is unsaved' => 'Hindi pa na-save ang pahina',%0a'Top' => 'Itaas',%0a# access keys%0a# 'ak_save' => 's',%0a# 'ak_saveedit' => 'u',%0a# 'ak_preview' => 'p',%0a# 'ak_savedraft' => 'd',%0a# 'ak_textedit' => ',',%0a# 'e_rows' => '23',%0a# 'e_cols' => '60',%0a%0a%0a### Page history strings%0a'{$FullName} History' => 'Kasaysayan ng {$FullName}',%0a'Show minor edits' => 'Ipakita ang mga menor na pagbabago',%0a'Hide minor edits' => 'Itago ang mga menor na pagbabago',%0a'Show changes to markup' => 'Ipakita ang mga pagbabago sa markup',%0a'Show changes to output' => 'Ipakita ang mga pagbabago sa output',%0a'by' => 'ni',%0a'Restore' => 'Ibalik',%0a'Added line $DiffLines:' => 'Idinagdag na linya $DiffLines:',%0a'Added lines $DiffLines:' => 'Idinagdag na mga linya $DiffLines:',%0a'Changed line $DiffLines from:' => 'Binagong linya $DiffLines mula sa:',%0a'Changed lines $DiffLines from:' => 'Binagong mga linya $DiffLines mula sa:',%0a'Deleted line $DiffLines:' => 'Tinanggal na linya $DiffLines:',%0a'Deleted lines $DiffLines:' => 'Tinanggal na mga linya $DiffLines:',%0a'to:' => 'sa:',%0a%0a%0a### Page attribute strings%0a'Attributes' => 'Mga Atributo',%0a'{$FullName} Attributes' => 'Mga Atributo ng {$FullName}',%0a'Set new read password:' => 'Mag-set ng bagong read password:',%0a'Set new edit password:' => 'Mag-set ng bagong edit password:',%0a'Set new attribute password:' => 'Mag-set ng bagong attribute password:',%0a'Set new publish password:' => 'Mag-set ng bagong publish password:',%0a'Set new upload password:' => 'Mag-set ng bagong upload password:', %0a'(set by $PWSource)' => '(set ng $PWSource)',%0a'(using $PWCascade password)' => '(gamit ang $PWCascade password)',%0a'(protected)' => '(protektado)',%0a'EnterAttributes' => "Ilagay ang mga bagong atributo para sa pahinang ito sa ibaba. Ang pag-iiwan ng isang field na walang laman ay mag-iiwan ng atributo na hindi nababago. Upang i-clear ang isang atributo, ilagay ang 'clear'. Upang alisin ang isang password, ilagay ang 'nopass'.",%0a'The page has an "attr" attribute and cannot be deleted.' => 'Ang pahina ay may "attr" na atributo at hindi maaaring tanggalin.',%0a%0a%0a### Authorization strings%0a'Name' => 'Pangalan',%0a'Password' => 'Password',%0a'Password required' => 'Kailangan ang password',%0a'OK' => 'OK',%0a'Name/password not recognized' => 'Hindi kilala ang pangalan/password',%0a%0a%0a### Search strings%0a'Search Results' => 'Mga Resulta ng Paghahanap',%0a'SearchFor' => 'Mga resulta ng paghahanap para sa %3cem>$Needle%3c/em>',%0a'SearchFound' => '$MatchCount pahina ang nahanap mula sa $MatchSearched pahina na hinanap.',%0a%0a%0a### Upload strings%0a'Attachments for' => 'Mga attachment para sa',%0a'File to upload:' => 'File na ia-upload:',%0a'Name attachment as:' => 'Pangalan ng attachment bilang:',%0a'Upload' => 'Mag-upload',%0a'Uploads' => 'Mga Upload',%0a'ULby' => 'in-upload ni',%0a'ULsuccess' => 'matagumpay na na-upload',%0a'ULbadname' => 'hindi wastong pangalan ng attachment',%0a'ULbadtype' => "'$upext' ay hindi pinapayagang file extension",%0a'ULtoobig' => 'ang file ay mas malaki kaysa sa pinapayagang maximum ng webserver',%0a'ULtoobigext' => "ang file ay mas malaki kaysa sa pinapayagang maximum na $upmax bytes para sa '$upext' files",%0a'ULpartial' => 'hindi kumpletong file ang natanggap',%0a'ULnofile' => 'walang file na na-upload',%0a'ULexists' => 'file na may ganitong pangalan ay mayroon na',%0a'ULpquota' => 'lumagpas na sa group quota',%0a'ULtquota' => 'lumagpas na sa upload quota',%0a%0a%0a### GuiEdit button bar%0a'Emphasized' => 'Binibigyang-diin',%0a'Emphasized (italic)' => 'Binibigyang-diin (italic)',%0a'Strong' => 'Malakas',%0a'Strong (bold)' => 'Malakas (bold)',%0a'Page link' => 'Link ng pahina',%0a'Link to internal page' => 'Link sa panloob na pahina',%0a'link text' => 'teksto ng link',%0a'Link to external page' => 'Link sa panlabas na pahina',%0a'file.ext' => 'file.ext',%0a'Attach file' => 'Ikabit ang file',%0a'Big text' => 'Malaking teksto',%0a'Small text' => 'Maliit na teksto',%0a'Superscript' => 'Superscript',%0a'Subscript' => 'Subscript',%0a'Heading' => 'Pamagat',%0a'Subheading' => 'Sub-pamagat',%0a'Center' => 'Gitna',%0a'Unordered list' => 'Hindi nakaayos na listahan',%0a'Unordered (bullet) list' => 'Hindi nakaayos (bullet) na listahan',%0a'Ordered list' => 'Nakaayos na listahan',%0a'Ordered (numbered) list' => 'Nakaayos (numbered) na listahan',%0a'Indented text' => 'Naka-indent na teksto',%0a'Hanging indent' => 'Hanging indent',%0a'Horizontal rule' => 'Pahalang na linya',%0a'Table' => 'Mesa',%0a# access keys%0a# 'ak_em' => '',%0a# 'ak_strong' => '',%0a%0a%0a### Others%0a'(approve sites)' => '(aprubahan ang mga site)',%0a'This post has been blocked by the administrator' => 'Ang post na ito ay na-block ng administrator',%0a'Address blocked from posting' => 'Address na hinarangan mula sa pag-post',%0a'Text blocked from posting' => 'Teksto na hinarangan mula sa pag-post',%0a'Password encryption' => 'Pag-encrypt ng password',%0a'EditConflict' => "Ang pahinang ini-edit mo ay nabago mula nang simulan mong i-edit ito. Ang mga pagbabago ay na-merge sa teksto sa ibaba, maaari mong gustong suriin ang mga resulta ng merge bago pindutin ang save. Mga conflict na hindi nalutas ng system ay nasa pagitan ng &lt;&lt;&lt;&lt;&lt;&lt;&lt; at &gt;&gt;&gt;&gt;&gt;&gt;&gt;.",%0a'EditWarning' => "Ang pahinang ini-edit mo ay nabago mula nang simulan mong i-edit ito. Kung magpapatuloy ka, ang iyong mga pagbabago ay mag-o-overwrite sa anumang mga pagbabago na ginawa ng iba.",%0a'View changes' => 'Tingnan ang mga pagbabago',%0a'?invalid page name' => '?hindi wastong pangalan ng pahina',%0a'More information' => 'Karagdagang impormasyon',%0a"PmWiki can't process your request" => "Hindi maiproseso ng PmWiki ang iyong kahilingan",%0a'We are sorry for any inconvenience' => 'Paumanhin sa anumang abala',%0a'Return to' => 'Bumalik sa',%0a%0a%0a### Deprecated%0a# Use instead the translation for PageTitle/LinkText technical pages above%0a'{$Group}/RecentChanges' => '{$Group}/MgaKamakailangPagbabago', %0a%0a%0a### Historical%0a'not found' => 'hindi nahanap'%0a%0a
time=1720568979
